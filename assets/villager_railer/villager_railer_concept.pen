{
  "version": "2.14",
  "variables": {
    "bg": { "type": "color", "value": "#1a1c1fff" },
    "panel": { "type": "color", "value": "#24282eff" },
    "panelAlt": { "type": "color", "value": "#2c323aff" },
    "stroke": { "type": "color", "value": "#3d4652ff" },
    "title": { "type": "color", "value": "#f2efe8ff" },
    "body": { "type": "color", "value": "#b8c0caff" },
    "muted": { "type": "color", "value": "#7a8494ff" },
    "accent": { "type": "color", "value": "#c23b2cff" },
    "railSteel": { "type": "color", "value": "#8a939fff" },
    "leather": { "type": "color", "value": "#5c3d2eff" },
    "leatherDark": { "type": "color", "value": "#3a241aff" },
    "pouch": { "type": "color", "value": "#c4a574ff" },
    "skin": { "type": "color", "value": "#c8a67aff" },
    "font": { "type": "string", "value": "IBM Plex Sans" }
  },
  "children": [
    {
      "type": "frame",
      "id": "board",
      "x": 0,
      "y": 0,
      "name": "va:villager_railer — Idealizacao",
      "width": 1440,
      "height": 1100,
      "fill": "$bg",
      "layout": "vertical",
      "gap": 28,
      "padding": 40,
      "children": [
        {
          "type": "frame",
          "id": "hdr",
          "name": "Header",
          "width": "fill_container",
          "layout": "vertical",
          "gap": 8,
          "children": [
            {
              "type": "text",
              "id": "eyebrow",
              "fill": "$accent",
              "content": "VILLAGERS ADDON  ·  va:villager_railer",
              "fontFamily": "$font",
              "fontSize": 12,
              "fontWeight": "700",
              "letterSpacing": 1.2
            },
            {
              "type": "text",
              "id": "title",
              "fill": "$title",
              "content": "Assentador de Trilhos — conceito visual",
              "fontFamily": "$font",
              "fontSize": 32,
              "fontWeight": "700"
            },
            {
              "type": "text",
              "id": "subtitle",
              "fill": "$body",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "Idealizacao inspirada no fv:villager_clumper (Soldiers): mesmo DNA de trabalhador industrial (avental, oculos, pochetes), reinterpretado para logistica de trilhos — aco, redstone e alavanca.",
              "lineHeight": 1.35,
              "fontFamily": "$font",
              "fontSize": 14,
              "fontWeight": "normal"
            }
          ]
        },
        {
          "type": "frame",
          "id": "rowMain",
          "name": "Main Row",
          "width": "fill_container",
          "height": 520,
          "gap": 24,
