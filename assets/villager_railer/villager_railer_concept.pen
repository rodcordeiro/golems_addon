                      "type": "text",
                      "id": "prop1",
                      "fill": "$body",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "1. Bone de trabalhador com aba curta (nao so hood do clumper).",
                      "lineHeight": 1.3,
                      "fontFamily": "$font",
                      "fontSize": 12
                    },
                    {
                      "type": "text",
                      "id": "prop2",
                      "fill": "$body",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "2. Placas de ombro / caneleiras com marcas de trilho (linhas paralelas).",
                      "lineHeight": 1.3,
                      "fontFamily": "$font",
                      "fontSize": 12
                    },
                    {
                      "type": "text",
                      "id": "prop3",
                      "fill": "$body",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "3. Joia/lamp redstone no cinto — hint de powered_rail a cada 8.",
                      "lineHeight": 1.3,
                      "fontFamily": "$font",
                      "fontSize": 12
                    },
                    {
                      "type": "text",
                      "id": "prop4",
                      "fill": "$body",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "4. Alavanca na mao ou no cinto — foreshadow RAILER-M2 (lever summon).",
                      "lineHeight": 1.3,
                      "fontFamily": "$font",
                      "fontSize": 12
                    },
                    {
                      "type": "text",
                      "id": "prop5",
                      "fill": "$body",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "5. Pochetes tan (spikes / cartuchos de rail) — heranca direta do clumper.",
                      "lineHeight": 1.3,
                      "fontFamily": "$font",
                      "fontSize": 12
                    }
                  ]
                }
              ]
            }
          ]
