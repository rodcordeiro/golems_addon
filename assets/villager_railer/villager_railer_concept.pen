            {
              "type": "frame",
              "id": "diffCard",
              "name": "Clumper vs Railer",
              "width": "fill_container",
              "fill": "$panel",
              "cornerRadius": 12,
              "stroke": "$stroke",
              "strokeWidth": 1,
              "layout": "vertical",
              "gap": 8,
              "padding": 16,
              "children": [
                {
                  "type": "text",
                  "id": "diffTitle",
                  "fill": "$title",
                  "content": "Clumper → Railer (diferenciacao)",
                  "fontFamily": "$font",
                  "fontSize": 15,
                  "fontWeight": "700"
                },
                {
                  "type": "text",
                  "id": "diffBody",
                  "fill": "$body",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Clumper = mineracao/ore (couro puro, goggles, hood). Railer = mesma silhueta de blue-collar, mas leitura imediata de transporte: aco, vermelho de powered rail, alavanca. Nao reutilizar a texture sheet do clumper; derivar palette + layout de UV villager (head / torso / arms / legs) com overlays proprios no RP va:.",
                  "lineHeight": 1.35,
                  "fontFamily": "$font",
                  "fontSize": 12
                }
              ]
            },
            {
              "type": "frame",
              "id": "implCard",
              "name": "Impl notes",
              "width": "fill_container",
              "fill": "$panel",
              "cornerRadius": 12,
              "stroke": "$stroke",
              "strokeWidth": 1,
              "layout": "vertical",
              "gap": 8,
              "padding": 16,
              "children": [
                {
                  "type": "text",
                  "id": "implTitle",
                  "fill": "$title",
                  "content": "Notas para arte / RP (quando implementar)",
                  "fontFamily": "$font",
                  "fontSize": 15,
                  "fontWeight": "700"
                },
                {
                  "type": "text",
                  "id": "implBody",
                  "fill": "$body",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Entity va:villager_railer; geo base villager_handle ou repillager ok. Biome mark_variant 0–6 opcional (como clumper). Enable attachables se alavanca/rail forem item na mao. Icon contrato va:railer_contract = rail sobre paper. Este .pen e concept only — nao e texture sheet final.",
                  "lineHeight": 1.35,
                  "fontFamily": "$font",
                  "fontSize": 12
                }
              ]
            }
          ]
        }
