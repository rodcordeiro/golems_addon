                  "type": "frame",
                  "id": "propsCard",
                  "name": "Signature props",
                  "width": "fill_container",
                  "height": "fill_container",
                  "fill": "$panel",
                  "cornerRadius": 12,
                  "stroke": "$stroke",
                  "strokeWidth": 1,
                  "layout": "vertical",
                  "gap": 10,
                  "padding": 16,
